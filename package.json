{
  "name": "honeybee",
  "description": "a distributed YouTube live chat and moderation events collector",
  "version": "0.0.0",
  "type": "module",
  "author": "Yasuaki Uechi <y@uechi.io> (https://uechi.io/)",
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').chmodSync('dist/index.js', 0o755)\"",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsc -w",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/"
  },
  "main": "dist/index.js",
  "bin": {
    "honeybee": "dist/index.js",
    "hb": "dist/index.js"
  },
  "dependencies": {
    "@agendajs/mongo-backend": "^4.0.1",
    "@fastify/express": "^2.3.0",
    "@keyv/redis": "^3.0.1",
    "@stu43005/masterchat": "^1.5.0",
    "@typegoose/typegoose": "^12.2.0",
    "agenda": "^6.2.4",
    "axios": "^1.6.8",
    "bee-queue": "^1.7.1",
    "cache-manager": "^6.1.1",
    "cacheable": "^1.8.1",
    "decimal.js": "^10.6.0",
    "discord.js": "^14.19.3",
    "fastify": "^4.26.2",
    "googleapis": "^134.0.0",
    "holodex.js": "^2.0.5",
    "json-templates": "^5.0.0",
    "kafkajs": "^2.2.4",
    "keyv": "^5.1.2",
    "lodash-es": "^4.18.1",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.45",
    "mongoose": "~8.2.0",
    "node-fetch": "^2.7.0",
    "p-props": "^4.0.0",
    "p-queue": "^9.1.2",
    "prom-client": "^15.1.0",
    "redis": "^4.6.13",
    "yargs": "^17.7.2",
    "youtube-notification": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/diff": "^7.0.2",
    "@types/express": "^4.17.21",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.12.2",
    "@types/node-fetch": "^2.6.11",
    "diff": "^9.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "jest": "^29.7.0",
    "nock": "^13.5.4",
    "nock-record": "^0.3.9",
    "prettier": "^3.8.2",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1"
  },
  "resolutions": {
    "youtube-notification/**/axios": "^1.6.8"
  },
  "homepage": "https://github.com/uetchy/honeybee",
  "repository": {
    "type": "git",
    "url": "https://github.com/uetchy/honeybee.git"
  },
  "bugs": {
    "url": "https://github.com/uetchy/honeybee/issues"
  },
  "license": "MIT",
  "keywords": [
    "honeybee"
  ],
  "engines": {
    "node": ">=24"
  },
  "private": true
}
